datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  avatar       String?
  university   String         @default("جامعة الملك سعود / King Saud University")
  major        String         @default("علوم الحاسب / Computer Science")
  semester     String         @default("الفصل الأول 2024-2025")
  gpaScale     Float          @default(5.0)
  targetGpa    Float          @default(4.75)
  language     String         @default("ar")
  theme        String         @default("light")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  courses        Course[]
  timetableSlots TimetableSlot[]
  assignments    Assignment[]
  exams          Exam[]
  grades         GradeRecord[]
  studySessions  StudySession[]
  chatMessages   ChatMessage[]

  @@map("users")
}

model Course {
  id            String   @id @default(uuid())
  userId        String
  code          String
  nameAr        String
  nameEn        String
  creditHours   Int      @default(3)
  instructor    String?
  color         String   @default("#6366f1")
  locationRoom  String?
  termSemester  String?
  syllabusNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]
  assignments    Assignment[]
  exams          Exam[]
  grades         GradeRecord[]
  studySessions  StudySession[]

  @@map("courses")
}

model TimetableSlot {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  dayOfWeek Int // 0: Sunday, 1: Monday, 2: Tuesday, 3: Wednesday, 4: Thursday, 5: Friday, 6: Saturday
  startTime String // HH:mm format e.g. "08:00"
  endTime   String // HH:mm format e.g. "09:30"
  room      String?
  type      String   @default("lecture") // lecture, lab, tutorial
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("timetable_slots")
}

model Assignment {
  id               String   @id @default(uuid())
  userId           String
  courseId         String
  title            String
  description      String?
  dueDate          DateTime
  priority         String   @default("medium") // low, medium, high
  status           String   @default("pending") // pending, in_progress, completed
  gradeMax         Float?
  gradeReceived    Float?
  weightPercentage Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("assignments")
}

model Exam {
  id               String   @id @default(uuid())
  userId           String
  courseId         String
  title            String
  examDate         DateTime
  durationMinutes  Int      @default(90)
  locationRoom     String?
  seatNumber       String?
  weightPercentage Float?
  status           String   @default("upcoming") // upcoming, completed
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("exams")
}

model GradeRecord {
  id               String   @id @default(uuid())
  userId           String
  courseId         String?
  customCourseName String?
  termSemester     String   @default("Current")
  creditHours      Int      @default(3)
  letterGrade      String   @default("A+")
  gradePoints      Float    @default(5.0)
  isCompleted      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("grade_records")
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  courseId        String?
  title           String
  durationMinutes Int      @default(25)
  type            String   @default("pomodoro") // pomodoro, revision, assignment_prep, exam_cram
  isCompleted     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("study_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String // user, assistant
  content   String
  category  String? // general, study_plan, summary, quiz
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
